{
  "compilerOptions": {
    "target": "ES2017",
    "lib": [
      "dom",
      "dom.iterable",
      "esnext"
    ],
    "allowJs": true,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "react-jsx",
    "incremental": true,
    "plugins": [
      {
        "name": "next"
      }
    ],
    "paths": {
      "@/*": [
        "./src/*"
      ],
      "@worldwideview/wwv-plugin-sdk": [
        "./packages/wwv-plugin-sdk/src"
      ],
      "@worldwideview/wwv-plugin-sdk/manifest": [
        "./packages/wwv-plugin-sdk/src/manifest"
      ],
      "@local/*": [
        "./local-plugins/*/src"
      ]
    }
  },
  "include": [
    "next-env.d.ts",
    "**/*.ts",
    "**/*.tsx",
    ".next/types/**/*.ts",
    ".next/dev/types/**/*.ts",
    "**/*.mts"
  ],
  "exclude": [
    "node_modules",
    "scripts",
    "local-scripts",
    "local-seeders",
    "local-plugins",
    "packages/*/backend",
    ".worktrees",
    "tests",
    "playwright.config.ts"
  ]
}