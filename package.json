{
  "name": "worldwideview",

  "version": "2.68.25",

  "private": true,
  "license": "EL-2.0",
  "type": "module",
  "packageManager": "pnpm@9.15.4",
  "scripts": {
    "setup": "node scripts/setup.mjs",
    "test-worktree": "node scripts/test-worktree.mjs",
    "clean": "node -e \"const fs=require('fs');fs.rmSync('.next',{recursive:true,force:true})\"",
    "dev": "node scripts/dev.mjs",
    "dev:all": "concurrently -n \"dev,backends\" -c \"magenta,blue\" \"pnpm dev\" \"pnpm dev:backends\"",
    "dev:backends": "docker compose --profile engine up wwv-data-engine wwv-redis",
    "dev:plugins": "node scripts/watch-local-plugins.mjs",
    "predev": "node scripts/boot-db.mjs && npx dotenv-cli -c -- node scripts/safe-db-push.mjs && npx prisma generate && node scripts/copy-cesium.mjs && node scripts/sync-local-plugins.mjs",
    "copy-cesium": "node scripts/copy-cesium.mjs",
    "prebuild": "node scripts/check-build-env.mjs",
    "build": "next build --webpack",
    "start": "next start",
    "test": "vitest run",
    "test:pact": "vitest run tests/pact/",
    "test:e2e": "playwright test",
    "test:e2e:local": "playwright test --project=chromium --workers=2",
    "test:mutate": "stryker run",
    "lint:urls": "node scripts/lint-urls.mjs",
    "lint": "eslint . && node scripts/lint-urls.mjs",
    "check:demo-gates": "node scripts/check-demo-gates.mjs",
    "db:reset": "npx prisma migrate reset --force",
    "db:prune": "node scripts/db-prune.mjs",
    "generate": "prisma generate"
  },
  "dependencies": {
    "@better-auth/api-key": "1.7.5",
    "@better-auth/prisma-adapter": "1.7.5",
    "@modelcontextprotocol/sdk": "^1.30.0",
    "@prisma/adapter-pg": "^7.10.0",
    "@prisma/client": "^7.10.0",
    "@prisma/client-runtime-utils": "7.10.0",
    "@sentry/nextjs": "^10.75.2",
    "@supabase/ssr": "^0.12.7",
    "@supabase/supabase-js": "^2.117.0",
    "@types/pg": "^8.23.1",
    "@worldwideview/wwv-lib-aviation": "workspace:*",
    "@worldwideview/wwv-lib-incidents": "workspace:*",
    "@worldwideview/wwv-plugin-sdk": "workspace:*",
    "@zxcvbn-ts/core": "^4.2.0",
    "@zxcvbn-ts/language-common": "^4.1.3",
    "@zxcvbn-ts/language-en": "^4.1.1",
    "bcryptjs": "^3.0.3",
    "better-auth": "1.7.5",
    "cesium": "^1.145.0",
    "cheerio": "^1.2.0",
    "hls.js": "^1.7.3",
    "ioredis": "^6.0.0",
    "jose": "^6.2.9",
    "lucide-react": "^1.47.0",
    "next": "16.3.6",
    "openid-client": "^6.8.5",
    "pg": "^8.23.0",
    "prisma": "^7.10.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-player": "^3.4.0",
    "resium": "1.26.0",
    "satellite.js": "^7.1.0",
    "tslib": "^2.8.1",
    "undici": "^8.11.0",
    "ws": "^8.21.3",
    "zod": "^4.6.5",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@eslint/compat": "^2.1.1",
    "@eslint/eslintrc": "^3.3.7",
    "@pact-foundation/pact": "^17.1.4",
    "@pact-foundation/pact-cli": "^18.1.2",
    "@playwright/test": "^1.63.0",
    "@size-limit/file": "^14.0.0",
    "@stryker-mutator/core": "^9.6.1",
    "@stryker-mutator/vitest-runner": "^9.6.1",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^26.6.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/ws": "^8.18.1",
    "@typescript-eslint/eslint-plugin": "^8.70.1",
    "@typescript-eslint/parser": "^8.70.1",
    "@vitejs/plugin-react": "^6.1.1",
    "@vitest/coverage-v8": "4.1.10",
    "concurrently": "^10.0.5",
    "copy-webpack-plugin": "^14.0.0",
    "eslint": "^9.39.4",
    "eslint-config-airbnb": "^19.0.4",
    "eslint-config-airbnb-typescript": "^18.0.0",
    "eslint-config-next": "^16.3.6",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "fast-check": "^4.10.2",
    "jsdom": "^30.1.1",
    "rollup-plugin-external-globals": "^0.13.0",
    "size-limit": "^14.0.0",
    "supabase": "^2.117.0",
    "tree-kill": "^1.2.2",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vite": "^8.2.1",
    "vitest": "^4.1.11"
  },
  "pnpm": {
    "overrides": {
      "@spz-loader/core": "0.3.0",
      "minimatch@10.2.5>brace-expansion": "^5.0.9",
      "deepmerge-ts": "^8.0.0",
      "dompurify@<3.4.13": "^3.4.13",
      "fast-uri@<3.1.5": "^3.1.5",
      "form-data@<2.5.4": "^2.5.5",
      "form-data@>=3.0.0 <3.0.4": "^3.0.4",
      "form-data@>=4.0.0 <4.0.4": "^4.0.5",
      "hono@<4.12.21": "^4.12.21",
      "nanoid@<3.3.18": "^3.3.18",
      "qs@<6.15.2": "^6.15.2",
      "uuid@<11.1.1": "^11.1.1",
      "vitest@<4.1.0": "^4.1.8",
      "esbuild": ">=0.28.1"
    },
    "onlyBuiltDependencies": [
      "@prisma/engines",
      "@sentry/cli",
      "prisma",
      "protobufjs",
      "sharp",
      "esbuild",
      "better-sqlite3"
    ]
  },
  "size-limit": [
    {
      "path": ".next/static/chunks/**",
      "limit": "2 MB"
    }
  ],
  "engines": {
    "node": ">=20.0.0",
    "pnpm": ">=9.0.0"
  }
}

